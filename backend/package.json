    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "nanoid": "^5.0.9",
    "redis": "^6.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
