PORT=4000
# Use the SAME MongoDB URI as the main Intervue backend
# Both services must share one database so that Problem ObjectId refs and populate() work correctly
MONGODB_URI=your_mongodb_atlas_uri_here
CLIENT_ORIGIN=http://localhost:5173

DOCKER_MEMORY=256m
DOCKER_CPUS=1
DOCKER_TIMEOUT_MS=5000
DOCKER_PIDS_LIMIT=128
DOCKER_TMPFS_SIZE=64m

PYTHON_RUNNER_IMAGE=python-runner:3.12
JAVA_RUNNER_IMAGE=java-runner:21
CPP_RUNNER_IMAGE=cpp-runner:17
